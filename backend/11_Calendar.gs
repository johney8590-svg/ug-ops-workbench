/**
 * 行事曆上的特殊日子：國定假日、補假、補班、會影響業績的節日。存在 calendar 分頁，可以直接在試算表增修。
 * seedCalendar() 會把 2026 年底到 2027 年的日子填進去（已存在的不會重複）。
 * 來源：行政院人事行政總處公布的 115、116 年政府行政機關辦公日曆表（2025 年下半年起「只補假、不補班」，所以沒有補班日）。
 */
const CAL_SEED = [
  ['2026-12-22', '冬至', '節日'], ['2026-12-24', '平安夜', '節日'], ['2026-12-25', '行憲紀念日・聖誕節', '假日'], ['2026-12-31', '跨年夜', '節日'],
  ['2027-01-01', '元旦', '假日'],
  ['2027-02-04', '小年夜', '假日'], ['2027-02-05', '除夕', '假日'], ['2027-02-06', '春節初一', '假日'], ['2027-02-07', '春節初二', '假日'], ['2027-02-08', '春節初三', '假日'],
  ['2027-02-09', '春節補假', '補假'], ['2027-02-10', '春節補假', '補假'], ['2027-02-14', '西洋情人節', '節日'],
  ['2027-02-28', '和平紀念日', '假日'], ['2027-03-01', '和平紀念日補假', '補假'],
  ['2027-04-04', '兒童節', '假日'], ['2027-04-05', '清明節', '假日'], ['2027-04-06', '兒童節補假', '補假'],
  ['2027-04-30', '勞動節補假', '補假'], ['2027-05-01', '勞動節', '假日'], ['2027-05-09', '母親節', '節日'],
  ['2027-06-09', '端午節', '假日'], ['2027-08-08', '父親節', '節日'],
  ['2027-09-15', '中秋節', '假日'], ['2027-09-28', '教師節', '假日'],
  ['2027-10-10', '國慶日', '假日'], ['2027-10-11', '國慶日補假', '補假'], ['2027-10-25', '光復節', '假日'], ['2027-10-31', '萬聖節', '節日'],
  ['2027-12-22', '冬至', '節日'], ['2027-12-24', '行憲紀念日補假・平安夜', '補假'], ['2027-12-25', '行憲紀念日・聖誕節', '假日'], ['2027-12-31', '元旦補假・跨年夜', '補假']
];
function seedCalendar() {
  let n = 0;
  withLock_(function () {
    const have = {}; Store.rows('calendar').forEach(function (r) { have[r.date + '|' + r.name] = 1; });
    CAL_SEED.forEach(function (x) { if (!have[x[0] + '|' + x[1]]) { Store.append('calendar', { date: x[0], name: x[1], kind: x[2] }); n++; } });
  });
  console.log('行事曆新增 ' + n + ' 個日子，目前共 ' + Store.rows('calendar').length + ' 個');
  return n;
}
function calendarDays_(from, to) {
  return Store.rows('calendar').filter(function (r) { return isDate_(r.date) && r.date >= from && r.date <= to; })
    .map(function (r) { return { date: r.date, name: r.name, kind: ['假日', '補假', '補班', '節日'].indexOf(r.kind) >= 0 ? r.kind : '節日' }; });
}
